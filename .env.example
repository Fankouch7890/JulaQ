# =====================================
# JulaQ AI Agent - Environment Configuration
# =====================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env file to version control

# =====================================
# 1. FABRIC API CONFIGURATION
# =====================================
FABRIC_API_KEY=your_fabric_api_key_here
FABRIC_BASE_URL=https://api.fabric.example.com
FABRIC_TIMEOUT=30

# =====================================
# 2. OPENAI / LLM CONFIGURATION
# =====================================
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini
MAX_TOKENS=2000
TEMPERATURE=0.7

# =====================================
# 3. LANGGRAPH CONFIGURATION
# =====================================
LANGGRAPH_API_KEY=your_langgraph_key_here
LANGGRAPH_ENDPOINT=https://api.smith.langchain.com

# =====================================
# 4. APPLICATION SETTINGS
# =====================================
# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# =====================================
# 5. SERVER CONFIGURATION
# =====================================
HOST=0.0.0.0
PORT=8000
WORKERS=4

# =====================================
# 6. DATABASE CONFIGURATION (Optional)
# =====================================
# DATABASE_URL=postgresql://user:password@localhost:5432/julaQ
# REDIS_URL=redis://localhost:6379/0

# =====================================
# 7. ROBOTICS & AUTOMATION SETTINGS
# =====================================
# Robot communication timeout
ROBOT_TIMEOUT=60
# Max concurrent robot connections
MAX_ROBOT_CONNECTIONS=10
# Enable real-time telemetry
TELEMETRY_ENABLED=True

# =====================================
# 8. SECURITY & AUTHENTICATION
# =====================================
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# =====================================
# 9. LOGGING CONFIGURATION
# =====================================
LOG_FILE=logs/julaQ.log
LOG_FORMAT=json
# Size in MB before rotation
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=5

# =====================================
# 10. MONITORING & OBSERVABILITY
# =====================================
SENTRY_DSN=https://your_sentry_url_here
METRICS_ENABLED=True
TRACES_ENABLED=True

# =====================================
# 11. RATE LIMITING
# =====================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =====================================
# 12. FABRIC FOUNDATION COMPLIANCE
# =====================================
# Enable compliance checks for Fabric Foundation
FABRIC_COMPLIANCE_MODE=True
FABRIC_VERSION=latest
